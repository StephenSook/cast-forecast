{
  "name": "cast-forecast-web",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:task": "vitest run --config vitest.live-task.config.ts",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "test:keyscan": "vitest run --config vitest.keyscan.config.ts",
    "record:sample": "vitest run --config vitest.record.config.ts",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "sync:gates": "node scripts/sync-gates.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.2"
  }
}
